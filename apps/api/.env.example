# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5435/video_factory"

# AI Provider selection: "mock" (default, no credentials) | "vertex"
AI_PROVIDER="mock"

# Vertex AI (Google Cloud) — hanya dibutuhkan saat AI_PROVIDER="vertex"
# Gunakan salah satu: GOOGLE_APPLICATION_CREDENTIALS (service account file)
# atau GCLOUD_PROJECT + aplikasi default credentials (gcloud auth application-default login)
GCLOUD_PROJECT=""
GOOGLE_APPLICATION_CREDENTIALS=""
VERTEX_LOCATION="asia-southeast1"

# Model override (opsional)
GEMINI_TEXT_MODEL="gemini-2.5-flash"
IMAGEN_MODEL="imagen-4.0-generate-001"
VIDEO_MODEL="gemini-omni-flash"
TTS_MODEL="gemini-2.5-flash-preview-tts"

# API server
API_PORT=4000