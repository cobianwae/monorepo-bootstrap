{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "docs/ARCHITECTURE.md",
    "docs/CONVENTIONS.md",
    "docs/design/visual-language.md"
  ],
  "snapshots": false,
  "formatter": false,
  "tool_output": {
    "max_lines": 500,
    "max_bytes": 12288
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      ".git/**",
      "dist/**",
      "build/**",
      ".next/**",
      "coverage/**",
      "graphify-out/**",
      "**/*.tsbuildinfo",
      "*.log",
      "/tmp/**"
    ]
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 12000
    }
  },
  "experimental": {
    "location_idle_timeout": "15 minutes"
  },
  "mcp": {
    "servers": {
      "graphify": {
        "type": "local",
        "command": [
          "sh",
          "-c",
          "~/.local/bin/graphify-mcp \"$(git rev-parse --path-format=absolute --git-common-dir)/../graphify-out/graph.json\""
        ]
      }
    }
  }
}
