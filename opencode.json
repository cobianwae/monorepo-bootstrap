{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "docs/ARCHITECTURE.md",
    "docs/CONVENTIONS.md",
    "docs/design/visual-language.md"
  ],
  "snapshots": true,
  "formatter": false,
  "tool_output": {
    "max_lines": 500,
    "max_bytes": 24576
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      ".git/**",
      "dist/**",
      "build/**",
      ".next/**",
      "coverage/**",
      "graphify-out/**",
      "**/*.tsbuildinfo",
      "*.log",
      "/tmp/**"
    ]
  },
  "compaction": {
    "auto": true,
    "buffer": "25%",
    "keep": {
      "tokens": 12000
    }
  },
  "providers": {
    "nim-coder": {
      "name": "Nim Coder",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://localhost:4101/v1",
        "apiKey": "unused"
      },
      "models": {
        "nim-coder": {
          "name": "Nim Coder"
        }
      }
    }
  },
  "agents": {
    "general": {
      "model": "nim-coder/nim-coder"
    }
  },
  "experimental": {
    "location_idle_timeout": "15 minutes"
  },
  "mcp": {
    "servers": {
      "graphify": {
        "type": "local",
        "command": [
          "sh",
          "-c",
          "~/.local/bin/graphify-mcp \"$(git rev-parse --path-format=absolute --git-common-dir)/../graphify-out/graph.json\""
        ]
      }
    }
  }
}
