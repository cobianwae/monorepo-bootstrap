{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["docs/ARCHITECTURE.md", "docs/CONVENTIONS.md"],
  "snapshots": false,
  "formatter": false,
  "tool_output": {
    "max_lines": 500,
    "max_bytes": 12288
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      ".git/**",
      "dist/**",
      "build/**",
      ".next/**",
      "coverage/**",
      "graphify-out/**",
      "**/*.tsbuildinfo",
      "*.log",
      "/tmp/**"
    ]
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 12000
    }
  },
  "experimental": {
    "location_idle_timeout": "15 minutes"
  },
  "provider": {
    "nim-coder": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Nim Coder",
      "options": {
        "baseURL": "http://localhost:4101/v1",
        "apiKey": "unused"
      },
      "models": {
        "nim-coder": {
          "name": "Nim Coder",
          "reasoning": true
        }
      }
    },
    "nim-thinker": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Nim thinker",
      "options": {
        "baseURL": "http://localhost:4100/v1",
        "apiKey": "unused"
      },
      "models": {
        "nim-thinker": {
          "name": "Nim thinker",
          "reasoning": true
        }
      }
    },
    "vertex-garden": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Vertex MaaS (Proxy)",
      "options": {
        "baseURL": "http://localhost:4099",
        "apiKey": "unused"
      },
      "models": {
        "zai-org/glm-5-maas": {
          "name": "GLM MaaS",
          "reasoning": true
        },
        "zai-org/glm-5.2-maas": {
          "name": "GLM 5.2 MaaS",
          "reasoning": true
        },
        "deepseek-ai/deepseek-v4.1-flash-maas": {
          "name": "Deepseek MaaS",
          "reasoning": true
        },
        "qwen/qwen3-coder-480b-a35b-instruct-maas": {
          "name": "Qwen MaaS",
          "reasoning": true
        },
        "moonshotai/kimi-k2-thinking-maas": {
          "name": "Kimi MaaS",
          "reasoning": true
        }
      }
    },
      "vertexai-global": {
       "npm": "@ai-sdk/google-vertex",
       "name": "Google Vertex (SDK)",
       "options": {
         "project": "glm-free-trial",
         "location": "global",
          "googleAuthOptions": {
           "keyFile": "/home/fdikdik/Documents/vortex.json"
         }
       },
       "models": {
         "gemini-3.1-pro-preview": {
           "name": "Gemini 3.1 ProP",
           "reasoning": true
         },
         "gemini-3-flash-preview": {
           "name": "Gemini 3 FlashP",
           "reasoning": true
         },
         "gemini-3.1-flash-lite-preview": {
           "name": "Gemini 3.1 FlashLiteP",
           "reasoning": true
         },
         "gemini-3.7-flash":{
           "name": "Gemini3.7flash",
           "reasoning": true
         }
       }
     }
  },  
  "mcp": {
    "servers": {
      "graphify": {
        "type": "local",
        "command": [
          "sh",
          "-c",
          "~/.local/bin/graphify-mcp \"$(git rev-parse --path-format=absolute --git-common-dir)/../graphify-out/graph.json\""
        ]
      }
    }
  }
}
