    "test:tokens": "pnpm --filter @ds/tokens test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.67.0"
  }
}
