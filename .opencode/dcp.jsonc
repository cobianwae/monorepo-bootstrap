{
  "$schema": "https://raw.githubusercontent.com/Opencode-DCP/opencode-dynamic-context-pruning/master/dcp.schema.json",
  // Story/CR = source of truth lingkup kerja: isi file yang dibaca lewat read/edit
  // tidak boleh ter-compress di tengah sesi. Pola wajib berbentuk `**/docs/.../**`
  // agar cocok untuk path absolut maupun relatif.
  // Digabung (union) dengan setelan global di ~/.config/opencode/dcp.jsonc.
  "protectedFilePatterns": ["**/docs/stories/**", "**/docs/cr/**"]
}
