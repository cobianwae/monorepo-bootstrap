{
  "$schema": "https://unpkg.com/oh-my-opencode-slim@latest/oh-my-opencode-slim.schema.json",

  // Override KHUSUS project ini. Model/preset TIDAK didefinisikan di sini:
  // diwarisi dari ~/.config/opencode/oh-my-opencode-slim.jsonc (preset aktif
  // user, saat ini "01-utama"), jadi tidak ada perubahan biaya/model.
  // File ini hanya mengatur grant skill/MCP per agent agar sesuai workflow
  // repo (gate PRD -> design -> story -> implementasi, design system first).
  // Prompt tambahan per agent ada di .opencode/oh-my-opencode-slim/*_append.md
  // (append kecil, bukan rewrite prompt bawaan Slim).

  "agents": {
    // Orchestrator = sesi utama: butuh seluruh skill workflow project untuk
    // routing & gate, plus MCP graphify untuk pertanyaan struktural.
    "orchestrator": {
      "skills_include_local": true,
      "mcps": ["*"]
    },

    // Oracle hanya untuk eskalasi arsitektur/risiko tinggi: skill keputusan
    // & review saja, tanpa skill implementasi.
    "oracle": {
      "skills_add": ["decision-framework", "reviewer", "product-ux"],
      "mcps": ["graphify"]
    },

    // Explorer (Slim) = recon luas + docs eksternal. Scout repo harian tetap
    // agent project `explore` (nim-coder, path:line); lihat routing di
    // orchestrator_append.md. Read-only, jadi tanpa skill implementasi.
    "explorer": {
      "skills_add": [],
      "mcps": ["graphify"]
    },

    // Designer = semua UI/UX: visual, token, a11y, pola UX.
    "designer": {
      "skills_add": [
        "visual-design",
        "ui-designer",
        "visual-designer",
        "designer",
        "design-tokens",
        "ux-patterns",
        "accessibility",
        "product-ux",
        "ux-psychology"
      ],
      "mcps": ["graphify"]
    },

    // Fixer = implementasi mekanis multi-file sesuai story/CR: skill kode
    // per package + verifikasi. Tanpa skill PRD/design (itu ranah orchestrator).
    "fixer": {
      "skills_add": [
        "ui-component",
        "design-tokens",
        "accessibility",
        "ux-patterns",
        "visual-design",
        "shared-types",
        "backend-nestjs",
        "prisma-schema",
        "api-testing",
        "monorepo-ci"
      ],
      "mcps": ["graphify"]
    }
  }

  // Catatan: agent project `.opencode/agents/explore.md` dan
  // `ui-ux-auditor.md` BUKAN agent Slim; keduanya tetap dipakai lewat
  // routing di orchestrator_append.md, tidak didaftarkan ulang di sini.
  // `observer` tetap nonaktif (default Slim): orchestrator preset aktif
  // sudah multimodal, tidak perlu agent vision terpisah.
}
